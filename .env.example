APP_NAME=PHLGADIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# The first administrator's password when `db:seed` creates the account.
# Required in production; local seeding falls back to a shared development password.
ADMIN_PASSWORD=
# The password accounts created in Settings → Users start with. Each holder
# must choose their own the first time they sign in.
AUTH_TEMPORARY_PASSWORD=password
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Uploads stay on this machine (local) or go to a DigitalOcean Spaces bucket
# (spaces). Each environment writes under its own folder (SPACES_ROOT,
# APP_ENV by default). Keep the key and secret out of git.
FILESYSTEM_UPLOADS=local
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=sgp1
SPACES_BUCKET=
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is optional: set SESSION_DRIVER, QUEUE_CONNECTION and CACHE_STORE to
# redis. Use REDIS_CLIENT=predis where PHP lacks the phpredis extension (for
# example on Windows). Apps that share one Redis server each need their own
# REDIS_DB and REDIS_CACHE_DB, because cache:clear empties a whole database.
# Managed Redis (DigitalOcean) only accepts TLS: set REDIS_SCHEME=tls and
# REDIS_USERNAME=default.
REDIS_CLIENT=phpredis
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# HEIDA, CHED's HEI directory: the nightly sync copies its regions and HEIs
# (php artisan surveys:sync-heis). Only its public endpoints are read, so no
# token is needed.
HEIDA_API_URL=https://v2.heida.ched.gov.ph
